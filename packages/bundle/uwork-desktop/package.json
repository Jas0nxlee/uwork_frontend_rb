{
  "name": "@deepseek-ai/dsh-uwork-desktop",
  "description": "UWork product layer over the standard dsh desktop profile",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/uwork-desktop"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-uwork": "workspace:*",
    "@deepseek-ai/dsh-uwork-company-market": "workspace:*",
    "@deepseek-ai/dsh-client-ui-uwork-company-market": "workspace:*",
    "@deepseek-ai/dsh-native-authorization": "workspace:*",
    "@deepseek-ai/dsh-uwork-enterprise": "workspace:*",
    "@deepseek-ai/dsh-uwork-gateway": "workspace:*",
    "@deepseek-ai/dsh-uwork-gateway-service": "workspace:*",
    "@deepseek-ai/dsh-uwork-model-provisioning": "workspace:*",
    "@deepseek-ai/dsh-client-ui-uwork-enterprise": "workspace:*",
    "@deepseek-ai/dsh-client-ui-uwork-usage": "workspace:*",
    "@deepseek-ai/dsh-client-ui-uwork-interactions": "workspace:*",
    "@deepseek-ai/dsh-client-ui-uwork-conversation": "workspace:*",
    "@deepseek-ai/dsh-client-ui-uwork-workbench": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
